# --- Deployment (never commit real values) ----------------------------------
DEPLOYER_PRIVATE_KEY=
AMOY_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_RPC_URL=https://polygon.drpc.org
POLYGONSCAN_API_KEY=

# Optional overrides; the deploy script defaults these to the deployer.
PLATFORM_TREASURY=
ADMIN_ADDRESS=
PAUSER_ADDRESS=
ARBITRATOR_ADDRESS=
# Required on mainnet only. Leave PAYMENT_TOKEN empty on a testnet to deploy MockUSDC.
PAYMENT_TOKEN=
AUDIT_COMPLETE=false
# Mainnet only: reviewed manifest created by `npm run audit:freeze` on the audited commit.
AUDITED_MANIFEST_PATH=

# --- Protocol parameters (defaults shown) -----------------------------------
TAX_BPS=700
DEPOSIT_BPS=500
DISPUTE_BOND_BPS=200
REVIEW_ELIGIBILITY_BPS=5000
REVIEW_SATURATION_BPS=10000
REVIEW_REPEAT_WEIGHT_BPS=2500
REVIEW_UNATTESTED_WEIGHT_BPS=5000

# --- Frontend: fill from scripts/deploy.js output ---------------------------
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy.drpc.org
NEXT_PUBLIC_AMOY_BOOKING_ADDRESS=
NEXT_PUBLIC_AMOY_REVIEW_REGISTRY=
NEXT_PUBLIC_AMOY_LENS_ADDRESS=
NEXT_PUBLIC_AMOY_PAYMENT_TOKEN=
