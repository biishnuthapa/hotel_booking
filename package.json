{
  "name": "hospitality-booking-v3",
  "version": "3.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "contracts:compile": "hardhat compile",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "vitest run",
    "test:contracts": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:e2e": "playwright test",
    "deploy:v3:local": "hardhat run scripts/deploy-v3.js --network localhost",
    "deploy:v3:amoy": "hardhat run scripts/deploy-v3.js --network amoy",
    "deploy:v3:polygon": "hardhat run scripts/deploy-v3.js --network polygon",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "lifecycle:amoy": "hardhat run scripts/amoy-lifecycle.js --network amoy",
    "amoy": "npm run deploy:amoy && npm run lifecycle:amoy"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@rainbow-me/rainbowkit-siwe-next-auth": "0.5.0",
    "@tanstack/react-query": "5.101.4",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "next": "16.3.1",
    "next-auth": "4.24.15",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "11.1.0",
    "sharp": "0.35.3",
    "siwe": "3.0.0",
    "valtio": "1.13.2",
    "viem": "2.55.18",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "autoprefixer": "10.5.4",
    "chai": "4.5.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "hardhat": "2.29.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "solidity-coverage": "0.8.17",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "axios": "1.19.0",
    "bn.js": "5.2.5",
    "jose": "4.15.9",
    "lodash": "4.18.1",
    "picomatch": "2.3.2",
    "sha.js": "2.4.12",
    "uuid": "11.1.1",
    "ws": "8.21.3"
  }
}
